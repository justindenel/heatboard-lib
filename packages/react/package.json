{
	"name": "@heatboard/react",
	"version": "0.1.1",
	"description": "React components for heat-based competition brackets: bracket view, judging, scoring and editor.",
	"license": "MPL-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/justindenel/heatboard-lib.git",
		"directory": "packages/react"
	},
	"homepage": "https://github.com/justindenel/heatboard-lib/tree/main/packages/react#readme",
	"bugs": {
		"url": "https://github.com/justindenel/heatboard-lib/issues"
	},
	"keywords": [
		"heats",
		"bracket",
		"competition",
		"judging",
		"surf",
		"windsurf",
		"kite",
		"react"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles.css": {
			"source": "./src/styles.css",
			"default": "./dist/styles.css"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19"
	},
	"dependencies": {
		"@dnd-kit/core": "~6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@heatboard/core": "workspace:^"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"jsdom": "^31.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"vite": "^8.3.6"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./styles.css": {
				"default": "./dist/styles.css"
			}
		}
	}
}
